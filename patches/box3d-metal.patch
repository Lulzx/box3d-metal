+cmake -S . -B build/metal-release -G Ninja -DCMAKE_BUILD_TYPE=Release \
+  -DBOX3D_SAMPLES=OFF -DBOX3D_BENCHMARKS=ON
+cmake --build build/metal-release --target metal_benchmark
+./build/metal-release/bin/metal_benchmark
