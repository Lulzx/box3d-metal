+	b3Capsule crossedCapsule = { .center1 = { 0.0f, 0.0f, -0.45f }, .center2 = { 0.0f, 0.0f, 0.45f }, .radius = 0.30f };
+	b3Sphere capsuleSphere = { .center = { 0.02f, -0.04f, 0.01f }, .radius = 0.35f };
+	for ( int i = 0; i < capsuleSphereCount; ++i )
