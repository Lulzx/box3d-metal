+inline ulong shift_right_jam(ulong value, uint distance) {
+    if (distance == 0) return value;
+    if (distance < 64) {
+        ulong discarded = value & ((1ul << distance) - 1ul);
+        return (value >> distance) | ulong(discarded != 0);
+    }
+    return ulong(value != 0);
