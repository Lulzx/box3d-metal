+	b3ShapeDef shapeDef = b3DefaultShapeDef();
+	shapeDef.baseMaterial.friction = 0.65f;
+	shapeDef.baseMaterial.restitution = 0.0f;
+	shapeDef.baseMaterial.rollingResistance = 0.1f;
