+	"    float3 qdv = 0.5f * p.h * w;\n"
+	"    float3 qv = dq.xyz + cross(qdv, dq.xyz) + dq.w * qdv;\n"
+	"    float qw = dq.w - dot(qdv, dq.xyz);\n"
+	"    float q2 = dot(qv, qv) + qw * qw;\n"
+	"    if (q2 > 1.17549435e-35f) { float invQ = 1.0f / sqrt(q2); qv *= invQ; qw *= invQ; }\n"
