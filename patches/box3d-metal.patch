+	"};\n"
+	"struct ShapeInput {\n"
+	"  uint bodyIndex, shapeId, type; int proxyKey;\n"
+	"  float p1x,p1y,p1z,radius; float p2x,p2y,p2z,margin;\n"
+	"  float oldLx,oldLy,oldLz,oldUx,oldUy,oldUz;\n"
