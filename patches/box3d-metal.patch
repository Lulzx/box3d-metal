+	ENSURE( profile.positionDispatchCount == 0 );
+	ENSURE( maxTransformError <= 3.0e-4f );
+	ENSURE( maxVelocityError <= 3.0e-4f );
+
+	b3DestroyWorld( gpuWorld );
+	b3DestroyWorld( cpuWorld );
+	b3DestroyMesh( mesh );
+	return 0;
