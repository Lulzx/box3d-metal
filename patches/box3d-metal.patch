+		b3Vec3 aw = b3Body_GetAngularVelocity( cpuBodies[i] );
+		b3Vec3 bw = b3Body_GetAngularVelocity( gpuBodies[i] );
+		maxCpuUpwardVelocity = b3MaxFloat( maxCpuUpwardVelocity, av.y );
+		for ( int j = 0; j < 3; ++j )
