+void b3MetalCommitPairTreeRefit( b3MetalContext* context, const b3BroadPhase* broadPhase )
+{
+	if ( context == NULL || broadPhase == NULL || context->pairTreeBuffer == nil ) return;
+	context->pairTreeRevision = broadPhase->treeRevision;
+}
