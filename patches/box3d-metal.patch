+    if (exponent == 0) {
+        if (significand >= (1ul << 52)) exponent = 1;
+    } else if (exponent == 1 && significand < (1ul << 52)) {
+        // Subnormal operands use effective exponent 1 during alignment.
+        exponent = 0;
+    } else if (significand >= (1ul << 53)) {
+        significand >>= 1;
+        exponent += 1;
+    }
