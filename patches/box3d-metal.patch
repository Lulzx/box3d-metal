+	float lowerX, lowerY, lowerZ;
+	float upperX, upperY, upperZ;
+} b3MetalPairQueryRecord;
+
+typedef struct b3MetalPairCandidate
+{
+	int proxyId;
+	int treeType;
+	int shapeIndex;
+	int padding;
+} b3MetalPairCandidate;
+
